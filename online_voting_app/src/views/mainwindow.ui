  <property name="styleSheet">
   <string notr="true">/* =======================================================
   1. LEFT FRAMES (Gradient Background for both pages)
======================================================= */
QFrame#leftLoginFrame, QFrame#leftSignupFrame, QFrame#waitingFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                stop:0 #ffffff, 
                                stop:1 #e0eaf5);
    border-radius: 10px;
}

/* =======================================================
   2. RIGHT IMAGE FRAMES (Apply to both if duplicated)
======================================================= */
QFrame#rightImageFrame, QFrame#rightImageFrame_2 {
    border-image: url(:/images/votingImage.png) 0 0 0 0 stretch stretch;
}

/* =======================================================
   3. PRIMARY ACTION BUTTONS (Login, Register, Back)
      Smooth Solid Blue Pill shape
======================================================= */
QPushButton#loginSubmitBtn, QPushButton#signupSubmitBtn, QPushButton#adminWaitBackBtn {
    background-color: #3b5998; 
    color: white;
    border: none;
    border-radius: 20px; 
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#loginSubmitBtn:hover, QPushButton#signupSubmitBtn:hover, QPushButton#adminWaitBackBtn:hover {
    background-color: #4b6ea8; 
}

QPushButton#loginSubmitBtn:pressed, QPushButton#signupSubmitBtn:pressed, QPushButton#adminWaitBackBtn:pressed {
    background-color: #2a4170; 
}

/* =======================================================
   4. SECONDARY NAVIGATION BUTTONS (Switch Pages)
      Ghost/Outline Style
======================================================= */
QPushButton#goToSignupBtn, QPushButton#goToLoginBtn {
    background-color: transparent;
    color: #3b5998; 
    border: 2px solid transparent;
    border-radius: 15px;
    padding: 10px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#goToSignupBtn:hover, QPushButton#goToLoginBtn:hover {
    background-color: #eef2f9; 
    border: 2px solid #3b5998; 
}

QPushButton#goToSignupBtn:pressed, QPushButton#goToLoginBtn:pressed {
    background-color: #dbe4f0;
}

/* =======================================================
   5. ALL TEXT INPUTS (User, Pass, Email, etc.)
======================================================= */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 12px; 
    padding: 10px 15px;
    font-size: 14px;
    color: #333333;
}

QLineEdit:focus {
    border: 2px solid #3b5998; 
    background-color: #fbfcff;
}

/* =======================================================
   6. DASHBOARD SIDEBAR (User &amp; Admin)
======================================================= */
/* The dark sidebar container */
QFrame#userSidebarFrame, QFrame#adminSidebarFrame {
    background-color: #314a75; /* A much lighter, smoother slate-blue */
    border-right: 2px solid #3b5998;
}

/* Sidebar Title Labels (e.g., &quot;VOTER MENU&quot;) */
QFrame#userSidebarFrame QLabel, QFrame#adminSidebarFrame QLabel {
    color: white;
    font-size: 16px;
    font-weight: bold;
    padding: 15px;
}

/* Sidebar Navigation Buttons */
QFrame#userSidebarFrame QPushButton, QFrame#adminSidebarFrame QPushButton {
    background-color: transparent; 
    color: #e8eef7; /* Slightly brighter text to keep high contrast */
    text-align: left; /* Flushes text to the left */
    padding: 15px 20px; /* Taller padding for easy clicking */
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-radius: 0px; /* Removes pill shape for sidebar items */
}

/* Sidebar Hover, Pressed, AND Active (Checked) Effects */
QFrame#userSidebarFrame QPushButton:hover, 
QFrame#adminSidebarFrame QPushButton:hover,
QFrame#userSidebarFrame QPushButton:pressed, 
QFrame#adminSidebarFrame QPushButton:pressed,
QFrame#userSidebarFrame QPushButton:checked, 
QFrame#adminSidebarFrame QPushButton:checked {
    background-color: #4b6ea8; /* Boosted hover color */
    color: white;
    border-left: 5px solid #ffffff; /* Cool white indicator bar */
}

/* =======================================================
   8. PROFILE TOP BAR
======================================================= */
/* The Avatar Button */
QPushButton#userProfilePicBtn, QPushButton#adminProfilePicBtn {
    background-color: transparent;
    border: 2px solid #3b5998; /* A nice blue ring around the profile pic */
    border-radius: 25px; /* Makes it a perfect circle (assuming 50x50 size) */
}
QPushButton#userProfilePicBtn, QPushButton#adminProfilePicBtn:hover {
    border: 2px solid #4b6ea8; /* Lighter blue glow on hover */
}

/* The Name Label */
QLabel#userNameLabel, QLabel#adminNameLabel {
    color: #ffffff; /* Assuming this is on a light background now. If dark, use 'white' */
    font-size: 16px;
    font-weight: bold;
}


/* =======================================================
   10. DASHBOARD LAYOUT BACKGROUNDS
======================================================= */

/* The Top Navigation Bar (Holding Name and Profile Pic) */
QFrame#userTopNavbarFrame, QFrame#adminTopNavbarFrame {
    background-color: #314a75; /* Crisp white background */
    border-bottom: 2px solid #e0eaf5; /* Subtle grey-blue line separating header from content */
}

/* The Nested Inner Stack (Where the actual dashboard content goes) */
QStackedWidget#userContentStack, QStackedWidget#adminContentStack {
    background-color: #f5f7fb; /* Very soft grey/blue so the white cards/widgets pop out */
}

/* Ensure the Inner Pages themselves are also transparent so the stack color shows */
QWidget#userInnerPage_Home, QWidget#userInnerPage_Elections, QWidget#userInnerPage_Results {
    background-color: transparent; 
}

</string>
