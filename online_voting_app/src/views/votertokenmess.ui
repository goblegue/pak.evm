  <property name="styleSheet">
   <string notr="true">/* 1. Main Dialog Background */
QDialog {
    background-color: #FFFFFF;
}

/* 3. The QR Code Image Box */
QLabel#qrImageLabel {
    background-color: #F8F9FA;
    border: 2px dashed #BDC3C7; /* Nice dashed border to look like a scan area */
    border-radius: 12px;
    padding: 10px;
}

/* 4. The Details Text below the QR Code */
QLabel#detailsLabel, QLabel#electionidLabel {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 14px;
    color: #7F8C8D; /* Soft readable gray */
    margin-bottom: 15px;
}

/* 5. The OK Button (Matching your Green Register Button) */
QPushButton#okButton {
    background-color: #314a75; 
    color: white;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 15px;
    font-weight: bold;
    border: none;
    border-radius: 8px; /* Smooth rounded corners */
    min-height: 45px;
    min-width: 190px; /* Makes the button wide and clickable */
    margin-bottom: 15px;
}

/* Hover effect for the button */
QPushButton#okButton:hover {
    background-color: #219653; /* Slightly darker green */
}

/* Click effect for the button */
QPushButton#okButton:pressed {
    background-color: #1E8449;
}</string>
